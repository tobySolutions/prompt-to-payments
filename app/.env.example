# Devnet only. Copy to .env.local.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Circle devnet USDC (6 decimals). Get some at https://faucet.circle.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# The merchant wallet that receives payments. A public address, never a secret key.
MERCHANT_WALLET=
# Must match USDC_MINT. Read by the browser for the balance display only.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# The x402 service the Agent page calls (default http://localhost:4021). The hosted demo uses https://mamaput-x402.vercel.app
# NEXT_PUBLIC_X402_URL=http://localhost:4021
